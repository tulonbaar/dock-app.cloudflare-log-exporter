# Cloudflare API
Cloudflare__ApiToken=replace_me
Cloudflare__ZoneId=replace_me
Cloudflare__BaseUrl=https://api.cloudflare.com/client/v4
Cloudflare__QueryIntervalSeconds=60
Cloudflare__Dataset=http_requests
Cloudflare__SelectColumns=RayID,ZoneName,EdgeStartTimestamp,EdgeEndTimestamp,ClientIP,ClientCountry,ClientCity,ClientLatitude,ClientLongitude,ClientRequestMethod,ClientRequestScheme,ClientRequestHost,ClientRequestURI,ClientRequestBytes,EdgeResponseStatus,EdgeResponseBytes,EdgeResponseBodyBytes,EdgeResponseContentType,EdgeTimeToFirstByteMs,OriginResponseDurationMs,OriginResponseStatus
Cloudflare__TimeColumn=EdgeEndTimestamp
Cloudflare__MaxRows=5000
Cloudflare__IngestionDelaySeconds=180

# Local PoC storage
Storage__OutputPath=/app/data/cloudflare-logs.ndjson
Storage__TimeZoneId=Europe/Warsaw
Storage__RewriteCloudflareTimestampsToLocal=true
Storage__LookbackMinutes=5

# Future Elasticsearch direct sink (not used in PoC)
Elastic__Enabled=false
Elastic__Endpoint=http://elasticsearch:9200
Elastic__Username=elastic
Elastic__Password=changeme
Elastic__IndexName=cloudflare-logs
